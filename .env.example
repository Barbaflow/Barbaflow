# ─────────────────────────────────────────────────────────────────────────────
# Fonte de dados: "mock" (offline, dados fictícios) ou "supabase" (banco real).
VITE_DATA_SOURCE=mock

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — cliente (frontend). PUBLISHABLE_KEY é pública; NUNCA use a
# service_role no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — backend (Edge Functions / scripts). SERVICE_ROLE_KEY é SECRETA:
# só no servidor, nunca exposta ao navegador nem versionada com valor real.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# COBRANÇA / ASSINATURA (Paddle Billing via connector). Detalhes em
# docs/billing-setup.md. Use SEMPRE o ambiente de testes (sandbox).
#
# Público (frontend) — token do cliente Paddle. Em testes deve começar com
# "test_"; o app detecta sandbox por esse prefixo. NUNCA coloque uma chave
# secreta aqui.
VITE_PAYMENTS_CLIENT_TOKEN=test_xxx

# Os valores abaixo são SEGREDOS e NÃO vão no .env do frontend — configure-os
# como secrets das Edge Functions (supabase secrets set ...). Listados aqui só
# para documentar os nomes esperados; deixe SEM valor no repositório.
#
# PADDLE_SANDBOX_API_KEY=         # chave de conexão Paddle (sandbox) — SECRETO
# PADDLE_LIVE_API_KEY=            # chave de conexão Paddle (produção) — SECRETO
# LOVABLE_API_KEY=               # auth do connector gateway — SECRETO
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=  # verificação HMAC do webhook (sandbox) — SECRETO
# PAYMENTS_LIVE_WEBHOOK_SECRET=     # verificação HMAC do webhook (produção) — SECRETO
#
# Trava anti-produção: o webhook RECUSA eventos "live" a menos que esta flag
# seja explicitamente "true". Mantenha ausente/vazia durante os testes.
# BILLING_ALLOW_LIVE=
