# ═════════════════════════════════════════════════════════════════════════════
# BarbaFlow — variáveis de ambiente (TEMPLATE)
#
# Copie para .env.local e preencha com os valores do seu ambiente.
# NUNCA versione um arquivo com valores reais: só este template vai ao Git.
#
# O desenvolvimento é REMOTE-FIRST: o frontend roda local e fala com o projeto
# Supabase remoto. Não é preciso Docker nem `supabase start`.
# Ver docs/DESENVOLVIMENTO_REMOTO.md
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (navegador)
#
# Tudo com prefixo VITE_ é embutido no bundle e VISÍVEL para qualquer usuário.
# Só pode conter valores públicos. Nunca coloque chave administrativa aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Fonte de dados: "supabase" (banco real) ou "mock" (dados fictícios, offline).
# O padrão do código é "supabase"; use "mock" para trabalhar sem rede.
VITE_DATA_SOURCE=supabase

# URL do projeto Supabase.
#   Desenvolvimento/homologação: https://qfcngyyzyiwotehubifx.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Ref do projeto (o subdomínio da URL acima).
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Chave PUBLICÁVEL (anon / publishable). É pública por definição: a proteção
# real dos dados são as políticas de RLS, não o segredo desta chave.
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Token público do provedor de pagamento (client-side).
VITE_PAYMENTS_CLIENT_TOKEN=<client-token>

# Origem pública da aplicação, SEM barra final. Opcional.
#
# No navegador a origem atual sempre vence (localhost, Preview ou produção),
# então esta variável só é lida no SSR, para montar o link de recuperação de
# senha. Sem ela, o SSR cai no domínio de produção (https://barbaflow-delta.vercel.app).
# Cada endereço usado aqui precisa estar em Authentication → URL Configuration
# → Redirect URLs no painel do Supabase. Ver src/lib/auth-redirect.ts
# VITE_PUBLIC_SITE_URL=http://localhost:3000
# PUBLIC_SITE_URL=http://localhost:3000   # mesma coisa, para o processo de SSR

# ─────────────────────────────────────────────────────────────────────────────
# SERVIDOR / SCRIPTS — NUNCA NO FRONTEND
#
# Estas variáveis NÃO têm prefixo VITE_, e isso é proposital: se ganharem esse
# prefixo, vazam para o bundle do navegador. A chave administrativa bypassa
# RLS por completo — quem a tem lê e escreve qualquer linha de qualquer tenant.
#
# Use somente em: scripts Node (scripts/*.mjs) e Edge Functions.
# ─────────────────────────────────────────────────────────────────────────────

# Mesmos endereços da seção acima, para o código de servidor (SSR).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Chave administrativa. Prefira a Secret key nova (sb_secret_...); o
# service_role legado é aceito como alternativa. Guarde num gerenciador de
# segredos — nunca em ticket, print ou commit.
SUPABASE_SECRET_KEY=<secret-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # alternativa legada

# Segredo das rotas de cron (/hooks/reset-monthly-appointments e
# /hooks/process-account-deletions). Elas rodam com a chave administrativa e
# agem sobre todos os tenants — o header É a autorização inteira.
#
#   - mínimo de 32 caracteres; gere aleatório (openssl rand -base64 48);
#   - NÃO reaproveite a publishable/anon (vai no bundle) nem a administrativa:
#     o código recusa o boot da rota se o valor coincidir com uma delas;
#   - sem ele configurado, as duas rotas respondem 500 e não tocam no banco.
#
# Quem agenda o cron precisa enviar: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=<segredo-aleatorio-de-32-caracteres-ou-mais>

# Senha do banco do projeto remoto (Dashboard → Settings → Database).
# Exigida pelos scripts db:status:remote, db:lint:remote e db:dry-run — sem
# ela o Supabase CLI abriria um prompt interativo e o script travaria.
SUPABASE_DB_PASSWORD=<db-password>

# ─────────────────────────────────────────────────────────────────────────────
# SEED DE TESTE — ver .env.seed.example
#
# O seed tem travas próprias (ALLOW_TEST_SEED, SEED_CONFIRM_PROJECT_REF) e um
# arquivo de exemplo separado. Ele NÃO roda automaticamente e não faz parte do
# fluxo padrão de desenvolvimento.
# ─────────────────────────────────────────────────────────────────────────────
