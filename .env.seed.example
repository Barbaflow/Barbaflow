# ─────────────────────────────────────────────────────────────────────────────
# Variáveis do seed de teste do BarbaFlow (scripts/seed-barbaflow-test.mjs)
#
# NUNCA versione um .env.seed real com chaves. Este arquivo é só um EXEMPLO.
# A SECRET/SERVICE_ROLE só roda no servidor (Node) — jamais no frontend.
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase.
#   Desenvolvimento/homologação: https://qfcngyyzyiwotehubifx.supabase.co
#
# O fluxo padrão do projeto é remote-first (ver docs/DESENVOLVIMENTO_REMOTO.md).
# O script ainda aceita um stack local (http://127.0.0.1:54321) para quem tiver
# Docker, mas isso é opcional e não faz parte do fluxo suportado.
SUPABASE_URL=

# Chave administrativa (bypassa RLS). Use UMA das duas — a primeira que existir.
# Só no servidor. O script nunca imprime este valor.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # alternativa aceita

# Senha única aplicada a TODAS as contas de teste. O script nunca a imprime.
SEED_TEST_PASSWORD=

# Trava de segurança: precisa ser exatamente "true".
ALLOW_TEST_SEED=true

# Confirmação explícita do ALVO. Precisa bater com o ref derivado de SUPABASE_URL:
#   - remoto: qfcngyyzyiwotehubifx
#   - local:  local
# Sem esta confirmação o script recusa rodar (nunca escolhe ambiente em silêncio).
SEED_CONFIRM_PROJECT_REF=

# Só para o cleanup (scripts/cleanup-barbaflow-test.mjs): trava separada.
# ALLOW_TEST_SEED_CLEANUP=true
